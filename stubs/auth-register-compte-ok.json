{
  "request": {
    "method": "POST",
    "urlPath": "/api/comptes/v1/auth/register/compte",
    "headers": {
      "Content-Type": {
        "contains": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.nom)]"
      },
      {
        "matchesJsonPath": "$[?(@.contact)]"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "nom": "Compte Démo",
      "application": "gestion-compte",
      "status": "ACTIF",
      "contact": {
        "email": "owner@example.com"
      }
    }
  }
}
